# === Royal Hotel POS - Environment Configuration ===
# Copy to .env and fill in real values:  cp .env.example .env

# Server
NODE_ENV=production
PORT=3000

# ---------------------------------------------------------------------------
# SESSION_SECRET  (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------------
# Signs every login token. The server REFUSES TO START in production if this
# is missing, shorter than 32 characters, or left as the placeholder below.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Keep it stable across restarts, otherwise every cashier is logged out on each
# deploy. Use the SAME value on every instance if you run more than one.
SESSION_SECRET=change_this_to_a_very_long_random_secret_key_at_least_64_characters!

# ---------------------------------------------------------------------------
# POS_DATA_DIR  (STRONGLY RECOMMENDED)
# ---------------------------------------------------------------------------
# Absolute path where pos_database.json and backups/ live. Point this OUTSIDE
# the deploy folder so a redeploy can never wipe live sales data.
# Must be writable by the user running the app — startup fails loudly if not.
# Example (Hostinger/VPS): POS_DATA_DIR=/home/u123456789/pos_data
POS_DATA_DIR=

# Default password for the seeded Admin account. Change it immediately after
# the first login. It is never re-applied after that account has logged in.
# (An untouched account created by an older release that failed to load .env is
# repaired once, so the configured password actually works.)
#
# SECURITY: in production, if this is left empty the server generates a random
# one-time password and prints it to the server log instead of falling back to
# the publicly-known default. Set it here to choose your own strong password.
DEFAULT_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# ADMIN_PASSWORD_RESET  (EMERGENCY USE ONLY)
# ---------------------------------------------------------------------------
# If the existing Super Admin password is lost, temporarily set a new password
# here and restart the server. Sign in as Admin, REMOVE this variable, and
# restart again. Never leave it set: it can re-apply after a later password
# change. The value must be 4-128 characters; use a strong 12+ character value.
ADMIN_PASSWORD_RESET=

# Business Info Override (Optional - defaults to Royal Hotel)
# BUSINESS_NAME=Royal Hotel & Restaurant
# BUSINESS_TAGLINE=Fine Liquor, Cuisine & Hospitality

# Rate Limiting (Optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# CORS_ORIGINS  (OPTIONAL, RECOMMENDED IN PRODUCTION)
# ---------------------------------------------------------------------------
# Comma-separated allowlist of browser origins permitted to call the API.
# When empty, every origin is accepted (fine for a LAN POS; auth is still
# Bearer-token based). Pin it in production, e.g.:
#   CORS_ORIGINS=https://pos.yourdomain.com
# CORS_ORIGINS=

# ---------------------------------------------------------------------------
# GEMINI_API_KEY  (OPTIONAL — AI System Health Check)
# ---------------------------------------------------------------------------
# Enables the AI health-check assistant (Super Admin dashboard "System Health"
# card). When set, the POST /api/ai/health-check endpoint asks Gemini to analyse
# a live system snapshot (DB writability, low/out-of-stock, revenue, bookings,
# kitchen ingredients, …) and returns a plain-English report with recommendations.
#
# Get a key: https://aistudio.google.com/apikey
# When LEFT EMPTY the same endpoint still returns a full structured RULE-BASED
# health report (same schema), so the Super Admin always sees a status — the
# dashboard then shows a hint that the AI needs a key to activate.
#
# GEMINI_MODEL defaults to "gemini-2.0-flash"; override only if needed.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
