# === Royal Hotel POS - Environment Configuration ===

# Server
NODE_ENV=production
PORT=3000

# Security - IMPORTANT: Change this in production to a long random string (64+ chars)
SESSION_SECRET=change_this_to_a_very_long_random_secret_key_at_least_64_characters!

# Persistent Data Directory (Optional)
# For Hostinger / VPS: Use absolute path outside webroot for safety
# Example: POS_DATA_DIR=/home/u123456789/pos_data
POS_DATA_DIR=

# Business Info Override (Optional - defaults to Royal Hotel)
# BUSINESS_NAME=Royal Hotel & Restaurant
# BUSINESS_TAGLINE=Fine Liquor, Cuisine & Hospitality

# Rate Limiting (Optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
