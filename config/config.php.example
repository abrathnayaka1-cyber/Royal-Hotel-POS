<?php
/**
 * Hostinger Web Hosting Database Configuration Template
 * Rename this file to config.php or populate your environment variables
 */

return [
    'db' => [
        'host'     => getenv('DB_HOST') ?: 'localhost',
        'port'     => getenv('DB_PORT') ?: '3306',
        'database' => getenv('DB_NAME') ?: 'u123456789_pos_db',
        'username' => getenv('DB_USER') ?: 'u123456789_pos_user',
        'password' => getenv('DB_PASS') ?: 'YourStrongDbPasswordHere',
        'charset'  => 'utf8mb4',
    ],
    'app' => [
        'name'        => 'Royal Green Garden POS',
        'env'         => getenv('APP_ENV') ?: 'production',
        'cors_origin' => '*',
    ]
];

/*
 * Cross-origin requests:
 * The PHP API only reflects an Origin header when it belongs to the same host, or when it is
 * listed in the CORS_ALLOWED_ORIGINS environment variable (comma separated, exact match), e.g.
 *
 *   CORS_ALLOWED_ORIGINS=https://pos.example.com,https://admin.example.com
 *
 * Same-host deployments (frontend + api on one domain) need no configuration at all.
 */
